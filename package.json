{
  "name": "ellines-tech-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788 --ip 127.0.0.1 --show-interactive-dev-session=false",
    "dev:full": "npm run build && npm run preview:full",
    "dev:stack": "npm run build && npx --yes concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:full": "wrangler pages dev dist --port 5174 --ip 0.0.0.0 --show-interactive-dev-session=false",
    "lint": "eslint .",
    "check:media": "node scripts/check-media-refs.mjs",
    "generate:downloads": "node scripts/generate-downloads.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "wrangler": "^4.114.0"
  }
}
