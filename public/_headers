# Cloudflare Pages headers — SEO crawl assets + security defaults
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# Content-Security-Policy notes:
#  - 'unsafe-inline' on style-src is required by Tailwind's runtime style
#    injection and framer-motion's inline transforms.
#  - js.paystack.co is the Paystack Inline checkout popup.
#  - openstreetmap.org serves the Nyeri + Nairobi office map embeds.
#  - connect-src stays same-origin plus Paystack / GA4 / Sentry; ws: keeps `vite dev` HMR alive.
#  - googletagmanager.com is GA4 (loaded only after analytics consent).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://checkout.paystack.com")
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://js.paystack.co https://www.googletagmanager.com https://browser.sentry-cdn.com; connect-src 'self' https://api.paystack.co https://checkout.paystack.com https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.ingest.sentry.io https://*.ingest.de.sentry.io ws: wss:; frame-src https://checkout.paystack.com https://js.paystack.co https://www.openstreetmap.org; upgrade-insecure-requests
