# Vite public build-time vars (safe to expose in the browser).
# Set the same names as GitHub Actions secrets for production builds.

# Google Analytics 4 measurement ID (G-XXXXXXXX)
# VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML tag content (from Search Console → Ownership verification)
# VITE_GOOGLE_SITE_VERIFICATION=

# Booking calendar URL (Cal.com / Calendly). Falls back to WhatsApp if empty.
# VITE_BOOKING_URL=https://cal.com/your-username/30min

# Optional Sentry DSN for client error monitoring
# VITE_SENTRY_DSN=
